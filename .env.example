# Copy to .env and replace all secrets before starting.
DATABASE_URL=postgres://wealtharr:localdevchange@db:5432/wealtharr
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
CRON_TOKEN=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
NEXT_PUBLIC_APP_NAME=Wealtharr
# Optional SMTP (never exposed to browsers)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Discord: full Discord webhook URL, never shown in the UI
DISCORD_WEBHOOK_URL=
