DEBUG=1
SECRET_KEY=replace-with-a-long-unique-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# DEBUG=1 without DATABASE_URL uses a local sqlite db.
# Production .env.production MUST set:
# DEBUG=0
# SECRET_KEY=<50+ random characters>
# ALLOWED_HOSTS=wealtharr.vpn4u.cc
# CSRF_TRUSTED_ORIGINS=https://wealtharr.vpn4u.cc
# TURNSTILE_SITE_KEY=<Cloudflare site key>
# TURNSTILE_SECRET_KEY=<Cloudflare secret key>
# Database credentials are supplied by Compose in DATABASE_URL.
