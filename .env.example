# Development only: cp .env.example .env; export variables before run
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-secret-for-real-deployments
ALLOWED_HOSTS=localhost,127.0.0.1
# If omitted with DEBUG=1, local SQLite is used.
# DATABASE_URL=postgresql://wealtharr:password@localhost:5432/wealtharr
# Production, set DEBUG=0 and provide all of:
# SECRET_KEY=<50+ random characters>
# ALLOWED_HOSTS=wealtharr.vpn4u.cc
# CSRF_TRUSTED_ORIGINS=https://wealtharr.vpn4u.cc
# DATABASE_URL=postgresql://wealtharr:...@db:5432/wealtharr
# TURNSTILE_SITE_KEY=...
# TURNSTILE_SECRET_KEY=...
