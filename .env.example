# Local development example only; use DEBUG=1 and a local throwaway key.
DEBUG=1
SECRET_KEY=replace-with-a-local-only-random-key
ALLOWED_HOSTS=localhost,127.0.0.1
# Without DATABASE_URL or DATABASE_PASSWORD_FILE, DEBUG=1 uses SQLite.

# Production: copy to .env.production (never commit), then override:
# DEBUG=0
# ALLOWED_HOSTS=wealtharr.vpn4u.cc
# CSRF_TRUSTED_ORIGINS=https://wealtharr.vpn4u.cc
# TURNSTILE_SITE_KEY=<valid Cloudflare site key>
# TURNSTILE_SECRET_KEY=<valid Cloudflare private verification secret>
# The production Compose injects SECRET_KEY_FILE and DATABASE_PASSWORD_FILE.
# Store actual secrets in untracked ./secrets/django_secret_key and
# ./secrets/postgres_password. Preserve the existing SECRET_KEY verbatim
# during migration: existing encrypted webhook and SMTP data require it.
# Traefik Docker override also requires:
# WEALTHARR_HOST=wealtharr.vpn4u.cc
# TRAEFIK_DOCKER_NETWORK=<existing private proxy network>
# TRAEFIK_CERT_RESOLVER=<configured Traefik TLS resolver>
# WEALTHARR_ALLOWLIST_CIDRS=<VPN subnet or trusted ingress CIDR>
